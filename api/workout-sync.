import { createClient } from '@supabase/supabase-js';

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  // We use the Service Role Key to bypass Row Level Security since this webhook runs automatically without a logged-in user session
  const supabaseUrl = process.env.VITE_SUPABASE_URL;
  const supabaseKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

  if (!supabaseUrl || !supabaseKey) {
    return res.status(500).json({ error: 'Missing Vercel environment variables' });
  }

  const supabase = createClient(supabaseUrl, supabaseKey);

  try {
    const { type, distance, activeCalories, duration, hrv, avgHr } = req.body;

    // NOTE: Change 'fitness_logs' if your table is named differently
    const { error } = await supabase
      .from('fitness_logs') 
      .insert([
        {
          type: type,
          distance: distance,
          active_calories: activeCalories,
          duration: duration,
          hrv: hrv,
          avg_hr: avgHr,
        }
      ]);

    if (error) throw error;

    return res.status(200).json({ success: true, message: 'Workout synced successfully!' });
  } catch (error) {
    console.error('Database error:', error);
    return res.status(500).json({ error: 'Internal Server Error' });
  }
}
